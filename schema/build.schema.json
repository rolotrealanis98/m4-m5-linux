{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolotrealanis98/m4plus-linux/schema/build.schema.json",
  "title": "builds/<board>/<name>.yaml",
  "description": "A tested build recipe: what went into a payload and the sha256 of every ingredient and output. Never the binary.",
  "type": "object",
  "required": ["name", "board", "setup", "status", "date", "kernel", "outputs", "results"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "board": {"type": "string", "pattern": "^J[0-9]{3}[a-z]*$"},
    "setup": {"type": "string"},
    "status": {"type": "string", "enum": ["daily", "test", "retired"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}Z)?$"},
    "source": {"$ref": "#/$defs/url"},
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"os": {"type": "string"}, "system": {"type": "string"}}
    },
    "kernel": {
      "type": "object",
      "required": ["repo", "base", "release"],
      "additionalProperties": false,
      "properties": {
        "repo": {"$ref": "#/$defs/url"},
        "branch": {"type": "string"},
        "base": {"type": "string", "pattern": "^[0-9a-f]{12,40}$"},
        "release": {"type": "string"},
        "patches": {"type": "array", "items": {"$ref": "#/$defs/patchset"}},
        "config": {"type": "array", "items": {"type": "string"}},
        "toolchain": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {"$ref": "#/$defs/url"},
        "base": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "name": {"type": "string"},
        "patches": {"type": "array", "items": {"$ref": "#/$defs/patchset"}},
        "notes": {"type": "string"}
      }
    },
    "stage1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "patches": {"type": "array", "items": {"$ref": "#/$defs/patchset"}}
      }
    },
    "devicetree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "per_unit_values": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "initramfs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "per_unit": {"type": "boolean", "description": "true when it carries per-unit material (never hashed or published)"}
      }
    },
    "userspace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "repo": {"$ref": "#/$defs/url"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
          "version": {"type": "string"},
          "patches": {"type": "array", "items": {"$ref": "#/$defs/patchset"}},
          "notes": {"type": "string"}
        }
      }
    },
    "bootargs": {"type": "string", "description": "The kernel command line, scrubbed: placeholders such as <root-partition> for machine-specific values."},
    "chosen": {"type": "array", "items": {"type": "string"}, "description": "m1n1 chosen.* variables carried in the payload."},
    "outputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "ingredients": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "rollback": {"$ref": "#/$defs/artifact"},
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kbuild_build_timestamp": {"type": ["string", "null"]},
        "kbuild_build_user": {"type": ["string", "null"]},
        "kbuild_build_host": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    },
    "results": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^machines/[a-z0-9]+/results/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9.-]+\\.md$"}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "patchset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$"},
        "repo": {"$ref": "#/$defs/url"},
        "path": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "count": {"type": "integer", "minimum": 1},
        "description": {"type": "string"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{8,63}$"},
        "recorded_in": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
