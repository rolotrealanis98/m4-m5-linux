{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolotrealanis98/m4plus-linux/schema/result.schema.json",
  "title": "Front matter of machines/<board>/results/YYYY-MM-DD-<slug>.md",
  "type": "object",
  "required": ["date", "board", "setup", "kind", "kernel", "firmware", "attended", "features"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z$"},
    "board": {"type": "string", "pattern": "^J[0-9]{3}[a-z]*$"},
    "setup": {"type": "string"},
    "kind": {"type": "string", "enum": ["native"]},
    "build": {"type": "string"},
    "kernel": {"type": "string"},
    "payload": {"type": "string"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{8,63}$"},
    "firmware": {
      "type": "object",
      "required": ["os", "system"],
      "additionalProperties": false,
      "properties": {"os": {"type": "string"}, "system": {"type": "string"}}
    },
    "attended": {"type": "boolean"},
    "source": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "features": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "summary_of": {"type": "array", "items": {"type": "string"}, "description": "When the file summarises a short run series: the run names, one per section."}
  }
}
