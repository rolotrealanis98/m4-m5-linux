{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rolotrealanis98/m4-m5-linux/schema/machine.schema.json",
  "title": "machines/<board>/machine.yaml",
  "description": "Status source for one board. Feature ids come from schema/features.yaml; the evidence rules are enforced by tools/validate.py.",
  "type": "object",
  "required": ["board", "model", "identifier", "soc", "family", "owner", "setups", "features"],
  "additionalProperties": false,
  "properties": {
    "board": {"type": "string", "pattern": "^J[0-9]{3}[a-z]*$", "description": "Board id, e.g. J716s. The directory is the lower-case form."},
    "model": {"type": "string", "minLength": 3},
    "identifier": {"type": "string", "pattern": "^Mac[0-9]+,[0-9]+$"},
    "soc": {"type": "string", "pattern": "^T[0-9]{4}$"},
    "family": {"type": "string", "enum": ["M4", "M5"]},
    "draft": {"type": "boolean", "description": "true while the entry was written from public posts and the owner has not confirmed it."},
    "owner": {
      "description": "GitHub handle(s) of the people with the machine, without the @.",
      "anyOf": [
        {"$ref": "#/$defs/handle"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handle"}, "uniqueItems": true}
      ]
    },
    "status_repos": {"type": "array", "items": {"$ref": "#/$defs/url"}},
    "omacom_test_report": {"anyOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]},
    "notes": {"type": "string"},
    "setups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "owner": {"$ref": "#/$defs/handle"},
          "firmware": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "os": {"type": "string", "description": "/chosen firmware-version (the stub's stage 2)"},
              "system": {"type": "string", "description": "/chosen system-firmware-version (LLB)"}
            }
          },
          "stack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kernel": {"type": "string"},
              "loader": {"type": "string"},
              "userspace": {"type": "string"}
            }
          },
          "current_build": {"anyOf": [{"type": "string", "pattern": "^builds/[a-z0-9]+/[A-Za-z0-9._-]+\\.yaml$"}, {"type": "null"}]},
          "source": {"$ref": "#/$defs/url"},
          "notes": {"type": "string"}
        }
      }
    },
    "features": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+(\\.[a-z0-9-]+)?$": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/cell"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "handle": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "cell": {
      "type": "object",
      "required": ["setup", "state", "kind"],
      "additionalProperties": false,
      "properties": {
        "setup": {"type": "string"},
        "state": {"type": "string", "enum": ["works-daily", "works-test", "attended", "prepared", "blocked", "not-realistic", "untested", "reported"]},
        "kind": {"type": "string", "enum": ["native", "reported", "offline"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(https://[^\\s]+|results/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9.-]+\\.md(#[a-z0-9_-]+)?|\\.\\./\\.\\./[A-Za-z0-9_./-]+(#[a-z0-9_-]+)?)$"}
        },
        "upstream": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$"}, "uniqueItems": true},
        "verified": {"$ref": "#/$defs/date"},
        "claim": {"type": "string", "description": "For state reported: what the linked post says, in a few words."},
        "note": {"type": "string"}
      }
    }
  }
}
